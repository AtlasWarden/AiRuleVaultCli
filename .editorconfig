root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120
csharp_new_line_before_members_in_chained_calls = true
csharp_new_line_before_members_in_object_initializers = true
csharp_prefer_braces = true:error

[*.json]
indent_style = space
indent_size = 2
max_line_length = 120

[*.md]
max_line_length = 120
