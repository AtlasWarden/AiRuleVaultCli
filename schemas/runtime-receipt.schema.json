{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulevault.local/schema/runtime-receipt.schema.json",
  "title": "Runtime conformance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp",
    "run_id",
    "vault_id",
    "project_id",
    "runtime_canary_id",
    "runtime_basis_sha256",
    "validation_spec_sha256",
    "status",
    "failure_code"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "vault_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "maxLength": 64
    },
    "runtime_canary_id": {
      "type": "string",
      "pattern": "^RV-CANARY-[A-Za-z0-9-]{4,128}$"
    },
    "runtime_basis_sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "validation_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "failure_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    }
  }
}