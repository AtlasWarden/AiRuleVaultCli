{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulevault.local/schema/vault-identity.schema.json",
  "title": "Rule Vault identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vault_id"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "vault_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}